.board-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding-top: 170px;
    padding-bottom: 700px;
    align-items: center;
    justify-content: center;
}

.board-grid {
    flex-direction: column;
    align-items: center;
}

.board-row {
    flex-direction: row;
    margin-bottom: 16px;
}

.board-tile {
    width: 208px;
    height: 208px;
    margin-left: 8px;
    margin-right: 8px;
    border-width: 4px;
    border-radius: 28px;
    background-color: rgb(30, 30, 34);
    border-color: rgb(58, 58, 66);
    align-items: center;
    justify-content: center;
}

.board-tile__label {
    font-size: 96px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-center;
}
