.board-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
    padding-top: 260px;
}

.board-grid {
    flex-direction: column;
    align-items: center;
}

.board-row {
    flex-direction: row;
    margin-bottom: 20px;
}

.board-tile {
    width: 180px;
    height: 180px;
    margin-left: 10px;
    margin-right: 10px;
    border-width: 4px;
    border-radius: 12px;
    background-color: rgb(30, 30, 34);
    border-color: rgb(58, 58, 66);
    align-items: center;
    justify-content: center;
}

.board-tile__label {
    font-size: 84px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-center;
}
