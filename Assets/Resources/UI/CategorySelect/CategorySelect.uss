.category-select-root {
    flex: 1;
    padding: 72px;
    background-color: rgb(24, 24, 28);
    align-items: stretch;
}

.title {
    font-size: 84px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    -unity-text-align: upper-center;
    margin-bottom: 48px;
}

.length-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 36px;
}

.tab-button {
    flex-grow: 1;
    margin: 0 12px;
    padding: 30px;
    font-size: 42px;
    background-color: rgb(45, 45, 52);
    color: rgb(200, 200, 200);
    border-width: 0;
    border-radius: 20px;
}

.tab-button--active {
    background-color: rgb(83, 141, 78);
    color: rgb(255, 255, 255);
}

.category-scroll {
    flex: 1;
}

.category-list {
    flex-direction: column;
}

.category-card {
    background-color: rgb(45, 45, 52);
    border-radius: 20px;
    padding: 42px;
    margin-bottom: 30px;
}

.category-card:hover {
    background-color: rgb(58, 58, 66);
}

.category-card--selected {
    background-color: rgb(83, 141, 78);
}

.category-card__name {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
}

.category-card__description {
    font-size: 39px;
    color: rgb(190, 190, 190);
    margin-top: 12px;
    white-space: normal;
}

.back-button {
    margin-top: 48px;
    padding: 30px;
    font-size: 42px;
    background-color: rgb(60, 60, 68);
    color: rgb(230, 230, 230);
    border-width: 0;
    border-radius: 20px;
}
